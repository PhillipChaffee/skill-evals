{
  "description": "One research note.",
  "tags": ["files"],
  "checks": [
    {
      "type": "file_exists",
      "path": "docs/research/*.md",
      "created": true
    },
    {
      "type": "file_count",
      "path": "docs/research/*.md",
      "min": 1,
      "max": 1
    },
    {
      "type": "output_contains",
      "text": "done"
    }
  ],
  "timeoutSeconds": 300
}
