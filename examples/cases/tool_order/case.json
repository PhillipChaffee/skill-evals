{
  "description": "Two researchers in one turn, then exactly one synthesizer, and no researcher after it.",
  "tags": ["routing", "order"],
  "checks": [
    {
      "type": "tool_called",
      "kind": "subagent",
      "inputMatches": "researcher",
      "min": 2,
      "sameTurn": true
    },
    {
      "type": "tool_called",
      "kind": "subagent",
      "inputMatches": "synthesizer",
      "min": 1,
      "max": 1
    },
    {
      "type": "tool_order",
      "sequence": [
        { "kind": "subagent", "inputMatches": "researcher" },
        { "kind": "subagent", "inputMatches": "synthesizer" }
      ],
      "strict": true
    },
    { "type": "output_contains", "text": "done" }
  ],
  "timeoutSeconds": 300,
  "x-unblinded": {
    "words": ["test"],
    "why": "The word is part of the research question given to the first subagent (the testing question), and the case checks how subagents are ordered, not the topic."
  }
}
