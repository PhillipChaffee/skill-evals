{
  "description": "Two researchers and exactly one synthesizer are dispatched, the synthesizer's brief mentions the reports, and no planner is dispatched.",
  "tags": ["routing", "agents"],
  "checks": [
    { "type": "agent_dispatched", "agent": "researcher", "min": 2 },
    { "type": "agent_dispatched", "agent": "synthesizer", "min": 1, "max": 1 },
    {
      "type": "agent_dispatched",
      "agent": "synthesizer",
      "briefMatches": "report",
      "flags": "i"
    },
    { "type": "agent_dispatched", "agent": "planner", "max": 0 },
    { "type": "output_contains", "text": "done" }
  ],
  "timeoutSeconds": 300
}
