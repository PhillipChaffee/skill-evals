{
  "name": "skill-evals",
  "version": "0.1.0",
  "description": "Score how agent skills change agent behavior, from 0 to 1, in Claude Code, Codex, Cursor, OpenCode, and Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhillipChaffee/skill-evals.git"
  },
  "bin": {
    "skill-evals": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "//": "Deviations from the full-lint typescript template, each with its reason. (1) No \"private\", and name, version, description, license, repository, bin, exports, and files are set: this package is published. (2) The build and prepack scripts: Node does not strip types under node_modules, so the package ships compiled JavaScript. (3) @types/node: the sources use Node APIs, as the template's tsconfig comment instructs; 22 matches the engines floor.",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint .",
    "lint:graph": "depcruise --validate .dependency-cruiser.cjs src",
    "lint:lockfile": "lockfile-lint -p package-lock.json -t npm -a registry.npmjs.org -o \"https:\" -n -i -e false",
    "prepack": "npm run build",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.3.1",
    "eslint": "10.10.0",
    "eslint-plugin-jsdoc": "64.3.8",
    "eslint-plugin-sonarjs": "4.2.1",
    "knip": "6.35.1",
    "lockfile-lint": "5.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "^8.0.0",
    "vitest": "5.0.0"
  }
}
